From 763a115ad8f81b373c9ec8ab8d33a17066d98eed Mon Sep 17 00:00:00 2001
From: Kyle Sylvestre <kyles3133@gmail.com>
Date: Sun, 26 Jul 2026 22:32:22 -0400
Subject: [PATCH] add switch build

Update GLPlatform.h
---
 .github/workflows/ci.yml                      |  54 +++++++++++++++++-
 CMakeLists.txt                                |   6 +-
 icon-switch.jpg                               | Bin 22768 -> 26234 bytes
 src/SexyAppFramework/SexyAppBase.cpp          |  16 ++----
 src/SexyAppFramework/SexyAppBase.h            |   1 +
 src/SexyAppFramework/graphics/GLInterface.cpp |  12 +++-
 src/SexyAppFramework/graphics/GLPlatform.h    |  28 +++++++--
 .../platform/default/Window.cpp               |  19 +++++-
 .../platform/switch/Window.cpp                |  10 +++-
 9 files changed, 120 insertions(+), 26 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 4e02764..c318895 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -10,16 +10,68 @@ on:
       build_windows_release:
         description: "Build Windows Release"
         type: boolean
-        default: true
+        default: false
       build_android_release:
         description: "Build Android Release"
         type: boolean
         default: false
+      build_switch_release:
+        description: "Build Nintendo Switch Release"
+        type: boolean
+        default: false
 
 env:
   VCPKG_BINARY_SOURCES: clear
 
 jobs:
+  build-switch:
+    if: inputs.build_switch_release
+    name: Build for Nintendo Switch
+    runs-on: ubuntu-latest
+    container:
+      image: devkitpro/devkita64:latest
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+          ref: zuma
+
+      - uses: actions/checkout@v6
+        with:
+          repository: kyle-sylvestre/CircleShootApp
+          path: src/CircleShoot
+
+      - name: Create flat SexyAppFramework
+        shell: bash
+        run: |
+          bash scripts/create_flat_directory.sh
+
+      - name: Compile libopenmpt for Switch
+        shell: bash
+        run: |
+          source $DEVKITPRO/switchvars.sh
+          git clone https://github.com/OpenMPT/openmpt
+          cd openmpt
+          make CONFIG=gcc SHARED_LIB=0 DYNLINK=0 EXAMPLES=0 OPENMPT123=0 TEST=0 PREFIX=$PORTLIBS_PREFIX install 
+
+      - name: Compile Zuma-Portable for Switch
+        shell: bash
+        run: |
+          source $DEVKITPRO/switchvars.sh
+          mkdir build
+          cd build
+          aarch64-none-elf-cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE=-O2
+          make
+          aarch64-none-elf-strip zuma-portable.elf
+
+      - name: Upload Artifact
+        uses: actions/upload-artifact@v7
+        with:
+          name: zuma-portable-switch
+          path: |
+            ./build/zuma-portable.nro
+            ./build/zuma-portable.elf
+
   build-windows-msvc-x86-release:
     if: inputs.build_windows_release
     name: Build for Windows (Release MSVC x86)
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4b97787..8e2c22d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -310,11 +310,11 @@ if (WIN32)
 		endif()
 	endif()
 elseif (NINTENDO_SWITCH)
-	target_link_libraries(pvz-portable PRIVATE EGL glapi drm_nouveau)
+	target_link_libraries(pvz-portable PRIVATE GLESv2 EGL glapi drm_nouveau)
 
 	nx_generate_nacp(pvz-portable.nacp
-		NAME "PvZ Portable"
-		AUTHOR "wszqkzqk, etc., a community-driven port"
+		NAME "Zuma Portable"
+		AUTHOR "ksylvestre"
 		VERSION "0.1"
 	)
 
